{
  "name": "obsidian-rag-mcp",
  "version": "1.0.0",
  "description": "Local semantic and graph search MCP server for Obsidian vaults",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "obsidian-rag-mcp": "dist/index.js",
    "obsidian-rag": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
